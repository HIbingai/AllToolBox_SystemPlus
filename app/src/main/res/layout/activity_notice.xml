<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6E6EA"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_notice_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="cursive"
        android:text="@string/notice_page_title"
        android:textColor="#FF1F2732"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_notice_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_simple_card"
        android:lineSpacingExtra="6dp"
        android:padding="14dp"
        android:text="@string/notice_compat_content"
        android:textColor="#FF404C5E"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tv_notice_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:text="@string/notice_compat_footer"
        android:textColor="#FF576277"
        android:textSize="14sp" />

</LinearLayout>
